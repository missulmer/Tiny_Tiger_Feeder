{
  "name": "tiny-tiger-feeder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:firestore": "npx firebase-tools emulators:exec --only firestore --project demo-ttf \"npx vitest run tests/store/firestoreRepo.test.ts tests/auth/authStore.test.ts\""
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "google-auth-library": "^10.9.1",
    "zod": "^4.6.7"
  }
}
