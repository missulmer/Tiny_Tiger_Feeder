# Tiny Tiger Feeder server configuration. Copy to .env for local runs; never commit real values.
# On Cloud Run these are set with --set-env-vars / --set-secrets (see docs/deploy.md).

# The one Google account allowed to sign in (compared case-insensitively).
# Changing it revokes every token issued to the previous address.
ALLOWED_EMAIL=laura@ulmerandco.io

# Optional. After the first successful sign-in, set this to pin the Google account: copy the
# `sub` (Google account id) from the log line "google sign-in sub=..." in Cloud Run logs.
# When set, sign-in also requires the ID token's sub to match (email alone is not enough).
# ALLOWED_GOOGLE_SUB=

# Google OAuth client (type "Web application") used for sign-in.
# Its authorized redirect URI must be ${PUBLIC_BASE_URL}/oauth/google/callback.
GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
# Secret: keep it in Secret Manager in production.
GOOGLE_CLIENT_SECRET=replace-me

# Public origin of this server, https, no path or trailing slash.
# The Claude connector URL is ${PUBLIC_BASE_URL}/mcp. http://localhost:<port> is allowed for local dev.
PUBLIC_BASE_URL=http://localhost:8080

# GCP project holding the Firestore (Native mode) database. Required unless STORE=memory.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Local dev: STORE=memory keeps everything in memory (lost on restart).
# Or point at the Firestore emulator (GOOGLE_CLOUD_PROJECT then defaults to demo-ttf):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080   (emulator uses 8080; then run this server with PORT=8081)
# STORE=memory

# Optional. Comma-separated redirect URIs that dynamic client registration accepts.
# Default: Claude's callbacks, https://claude.ai/api/mcp/auth_callback and https://claude.com/api/mcp/auth_callback
# ALLOWED_REDIRECT_URIS=

# Port to listen on (Cloud Run sets this).
# PORT=8080
